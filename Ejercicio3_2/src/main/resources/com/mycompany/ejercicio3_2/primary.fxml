<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.ejercicio3_2.CarreraController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <children>
        <Label text="La Liebre y la Tortuga">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>

        <Button fx:id="btnIniciar" mnemonicParsing="false" onAction="#iniciarCarrera" text="¡Iniciar Carrera!" />

        <Label text="La Liebre:" />
        <ProgressBar fx:id="barLiebre" prefWidth="300.0" progress="0.0" />
        <Label fx:id="lblLiebre" text="En la línea de salida..." />

        <Label text="La Tortuga:" style="-fx-padding: 10 0 0 0;" />
        <ProgressBar fx:id="barTortuga" prefWidth="300.0" progress="0.0" />
        <Label fx:id="lblTortuga" text="En la línea de salida..." />
    </children>
</VBox>